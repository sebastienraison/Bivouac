<?xml version="1.0" encoding="utf-8"?>
<!-- RIC-95 : l'app est 100 % locale — les traces (base Room) et les préférences ne partent
     jamais dans la sauvegarde cloud Google. Le transfert direct appareil-à-appareil (aucune
     règle device-transfer : tout est transféré par défaut) reste complet, lui : il ne transite
     pas par le cloud et évite de perdre le journal en changeant de téléphone. La sauvegarde
     explicite (BIV-66, export .zip via SAF, écran Réglages) reste le mécanisme de sauvegarde
     assumé. Pendant du fichier full_backup_content.xml, utilisé par les API <= 30. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="bivouac.db" />
        <exclude domain="database" path="bivouac.db-wal" />
        <exclude domain="database" path="bivouac.db-shm" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
</data-extraction-rules>
