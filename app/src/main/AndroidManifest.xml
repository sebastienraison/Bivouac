<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".BivouacApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Ouverture directe d'un fichier .gpx depuis une autre application
                 (gestionnaire de fichiers, pièce jointe mail...), quand la source déclare
                 correctement le type MIME. Uniquement content:// : les Uri file:// sont
                 interdits à l'envoi depuis Android 7 (FileUriExposedException côté émetteur)
                 et l'app n'a de toute façon pas READ_EXTERNAL_STORAGE pour les ouvrir (RIC-95). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/gpx+xml" />
            </intent-filter>

            <!-- Repli : beaucoup de sources ne typent pas correctement les fichiers GPX
                 (type MIME générique ou absent) — on matche aussi sur l'extension. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.gpx" />
            </intent-filter>

            <!-- Partage d'un fichier .gpx vers l'app ("Partager" depuis un gestionnaire de
                 fichiers). Restreint au type MIME correct : ACTION_SEND ne porte pas de chemin
                 de fichier exploitable, donc pas de repli par extension possible ici. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
